# Copia este archivo como ".env" (en la carpeta backend) y llena tus propios valores.
# En internet (Render) estos valores se ponen en el panel "Environment", no en un archivo.

# --- Base de datos MySQL ---
MYSQL_HOST = 127.0.0.1
MYSQL_PORT = 3306
MYSQL_USER = root
MYSQL_PASSWORD =
MYSQL_DATABASE = ahorra_y_prospera
# Bases en internet (Aiven, etc.) piden conexión segura: MYSQL_SSL = true (y, si te dan un certificado,
# pega su contenido en MYSQL_SSL_CA con los saltos de línea escritos como \n)
MYSQL_SSL =
MYSQL_SSL_CA =

# --- Servidor ---
PORT = 5000
# Dirección pública de la app (la usan los botones de los correos)
APP_URL = http://localhost:5000

# --- Acceso con Google (https://console.cloud.google.com → Credenciales) ---
GOOGLE_CLIENT_ID =

# --- IA gratis para el chat y la educación (con una basta) ---
GEMINI_API_KEY =
GROQ_API_KEY =
ANTHROPIC_API_KEY =
IA_LIMITE_DIARIO = 20

# --- Correo para las alertas: sirve para cualquier destinatario (Gmail, Yahoo, Hotmail, @iesantaelena.edu.co, @elpoli.edu.co...) ---
# Opción recomendada y 100% gratis (funciona también en Render): Google Apps Script con tu Gmail.
# Sigue los pasos de backend/scripts/enviar-correo.gs y pega aquí la URL (termina en /exec) y la clave que elegiste.
APPS_SCRIPT_URL =
APPS_SCRIPT_CLAVE =
# Otra opción por API: Brevo (revisa su plan gratuito), BREVO_FROM p. ej.: Ahorra y Prospera <tucorreo@gmail.com>
BREVO_API_KEY =
BREVO_FROM =
# Alternativa: SMTP (Gmail con contraseña de aplicación). Solo se usa si no hay BREVO_API_KEY.
SMTP_HOST = smtp.gmail.com
SMTP_PORT = 587
SMTP_USER =
SMTP_PASS =
SMTP_FROM =

# --- n8n (opcional) ---
N8N_WEBHOOK_URL =
N8N_SECRET =
N8N_API_KEY =
