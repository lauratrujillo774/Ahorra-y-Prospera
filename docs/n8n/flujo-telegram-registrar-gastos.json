{
  "name": "Ahorra y Prospera - registrar gastos por Telegram",
  "nodes": [
    {
      "parameters": { "updates": ["message"], "additionalFields": {} },
      "id": "b2222222-0000-4000-8000-000000000001",
      "name": "Mensaje de Telegram",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [220, 300],
      "notes": "Escribe en el chat: gasto 25000 almuerzo   |   ingreso 1500000 salario   |   resumen"
    },
    {
      "parameters": {
        "jsCode": "// Entiende mensajes como: 'gasto 25000 almuerzo' | 'ingreso 1500000 salario' | 'resumen'\nconst texto = ($json.message?.text || '').trim();\nconst m = texto.match(/^(gasto|ingreso)\\s+([\\d.,]+)\\s*(.*)$/i);\nconst correo = 'PON_AQUI_TU_CORREO_DE_LA_APP';\nif (m) {\n  return [{ json: { accion: m[1].toLowerCase(), monto: Number(m[2].replace(/[.,]/g, '')), descripcion: m[3] || 'Registrado por Telegram', categoria: m[3] || '', correo, chat: $json.message.chat.id } }];\n}\nreturn [{ json: { accion: /resumen|c[oó]mo voy/i.test(texto) ? 'resumen' : 'ayuda', correo, chat: $json.message.chat.id } }];"
      },
      "id": "b2222222-0000-4000-8000-000000000002",
      "name": "Interpretar mensaje",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            { "conditions": { "options": { "caseSensitive": true, "typeValidation": "loose" }, "combinator": "or", "conditions": [ { "leftValue": "={{ $json.accion }}", "rightValue": "gasto", "operator": { "type": "string", "operation": "equals" } }, { "leftValue": "={{ $json.accion }}", "rightValue": "ingreso", "operator": { "type": "string", "operation": "equals" } } ] }, "renameOutput": true, "outputKey": "Registrar" },
            { "conditions": { "options": { "caseSensitive": true, "typeValidation": "loose" }, "combinator": "and", "conditions": [ { "leftValue": "={{ $json.accion }}", "rightValue": "resumen", "operator": { "type": "string", "operation": "equals" } } ] }, "renameOutput": true, "outputKey": "Resumen" }
          ]
        },
        "options": { "fallbackOutput": "extra" }
      },
      "id": "b2222222-0000-4000-8000-000000000003",
      "name": "¿Qué pidió?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [660, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'http://localhost:5000/n8n/' + $json.accion }}",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "x-api-key", "value": "PON_AQUI_TU_N8N_API_KEY" } ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ correo: $json.correo, monto: $json.monto, descripcion: $json.descripcion, categoria: $json.categoria }) }}"
      },
      "id": "b2222222-0000-4000-8000-000000000004",
      "name": "Registrar en la app",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 180]
    },
    {
      "parameters": {
        "url": "={{ 'http://localhost:5000/n8n/usuario?correo=' + encodeURIComponent($json.correo) }}",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "x-api-key", "value": "PON_AQUI_TU_N8N_API_KEY" } ] }
      },
      "id": "b2222222-0000-4000-8000-000000000005",
      "name": "Consultar resumen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 340]
    },
    {
      "parameters": {
        "chatId": "={{ $('Interpretar mensaje').item.json.chat }}",
        "text": "={{ $json.message ? '✅ ' + $json.message + ' (categoría: ' + ($json.categoria || '—') + ')' : '📊 Este mes: ingresos ' + $json.mes.ingresos + ', gastos ' + $json.mes.gastos + ', balance ' + $json.mes.balance + ' (' + $json.mes.porcentajeGastado + '% gastado)' }}"
      },
      "id": "b2222222-0000-4000-8000-000000000006",
      "name": "Responder en Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1140, 260]
    }
  ],
  "connections": {
    "Mensaje de Telegram": { "main": [ [ { "node": "Interpretar mensaje", "type": "main", "index": 0 } ] ] },
    "Interpretar mensaje": { "main": [ [ { "node": "¿Qué pidió?", "type": "main", "index": 0 } ] ] },
    "¿Qué pidió?": { "main": [ [ { "node": "Registrar en la app", "type": "main", "index": 0 } ], [ { "node": "Consultar resumen", "type": "main", "index": 0 } ] ] },
    "Registrar en la app": { "main": [ [ { "node": "Responder en Telegram", "type": "main", "index": 0 } ] ] },
    "Consultar resumen": { "main": [ [ { "node": "Responder en Telegram", "type": "main", "index": 0 } ] ] }
  },
  "settings": { "executionOrder": "v1" }
}
